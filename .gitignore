*.key

# Node / build artifacts (in case of future tooling)
node_modules/
dist/
build/
*.log

# Python (in case of future automation)
__pycache__/
*.pyc
.venv/
venv/

# Archive artifacts
*.tar.gz
*.zip
!releases/*.tar.gz
